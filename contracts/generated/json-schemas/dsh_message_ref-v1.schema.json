{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iris.dsh_message_ref.v1",
  "title": "DshMessageRefV1",
  "type": "object",
  "properties": {
    "schemaId": {
      "const": "iris.dsh_message_ref.v1"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "eventSeq": {
      "type": "integer",
      "minimum": 0
    },
    "sourceHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["schemaId", "sessionId", "messageId"],
  "additionalProperties": false
}
