{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iris.semantic.context_message.tool_call.v1",
  "type": "object",
  "properties": {
    "role": {
      "const": "assistant"
    },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            },
            "required": ["type", "text"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "image"
              },
              "attachmentRef": {
                "$comment": "DSH durable attachment 的 typed reference（iris_agent#128 A3）。attachmentId 是 content-addressed 不可变存储的稳定标识（不是文件路径/bearer URL/图片字节）；bytes/width/height 是持久元数据。不可用/校验失败时渲染必须 fail-closed，不得把 attachmentId 当图片 data。",
                "type": "object",
                "properties": {
                  "schemaId": {
                    "const": "iris.dsh_attachment_ref.v1"
                  },
                  "attachmentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mediaType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": ["schemaId", "attachmentId", "mediaType", "bytes", "width", "height"],
                "additionalProperties": false
              },
              "data": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              }
            },
            "oneOf": [
              {
                "required": ["type", "attachmentRef"]
              },
              {
                "required": ["type", "data", "mimeType"]
              }
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "toolCall"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "object"
              },
              "thoughtSignature": {
                "type": "string"
              }
            },
            "required": ["type", "id", "name", "arguments"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "thinking"
              },
              "text": {
                "type": "string"
              },
              "signature": {
                "type": "string"
              },
              "redacted": {
                "type": "boolean"
              }
            },
            "required": ["type", "text"],
            "additionalProperties": false
          }
        ]
      }
    },
    "toolCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "toolCall"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "thoughtSignature": {
            "type": "string"
          }
        },
        "required": ["type", "id", "name", "arguments"],
        "additionalProperties": false
      }
    },
    "timestamp": {
      "type": "number"
    }
  },
  "required": ["role", "content"],
  "additionalProperties": false
}
