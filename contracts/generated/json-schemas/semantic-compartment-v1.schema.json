{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iris.semantic.compartment.v1",
  "type": "object",
  "properties": {
    "schemaId": {
      "const": "iris.semantic.compartment.v1"
    },
    "compartmentId": {
      "type": "string",
      "minLength": 1
    },
    "compartmentSequence": {
      "type": "integer",
      "minimum": 1
    },
    "lineageId": {
      "type": "string",
      "minLength": 1
    },
    "startContextSeq": {
      "type": "integer",
      "minimum": 1
    },
    "endContextSeq": {
      "type": "integer",
      "minimum": 1
    },
    "sourceRangeHash": {
      "type": "string",
      "minLength": 1
    },
    "importance": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "episodeType": {
      "type": "string",
      "enum": ["request_response", "tool_execution", "maintenance"]
    },
    "content": {
      "type": "string"
    },
    "primarySummary": {
      "type": "string"
    },
    "secondarySummary": {
      "type": "string"
    },
    "decisions": {
      "type": "string"
    },
    "openThreads": {
      "type": "string"
    }
  },
  "required": [
    "schemaId",
    "compartmentId",
    "compartmentSequence",
    "lineageId",
    "startContextSeq",
    "endContextSeq",
    "sourceRangeHash",
    "importance",
    "episodeType"
  ],
  "additionalProperties": false
}
