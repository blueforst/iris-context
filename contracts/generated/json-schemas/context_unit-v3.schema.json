{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "iris.context_unit.v3",
  "title": "ContextUnitV3",
  "type": "object",
  "properties": {
    "schemaId": {
      "const": "iris.context_unit.v3"
    },
    "unitId": {
      "type": "string",
      "minLength": 1
    },
    "contextId": {
      "type": "string",
      "minLength": 1
    },
    "contentSchemaId": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": ["string", "number", "boolean", "null", "object", "array"]
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "object"
    },
    "derivation": {
      "type": "object",
      "properties": {
        "schemaId": {
          "const": "iris.semantic_derivation_refs.v1"
        },
        "memoryRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compartmentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workSnapshotVersion": {
          "type": "integer"
        },
        "sourceContextMessageUnitIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["schemaId"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaId",
    "unitId",
    "contextId",
    "contentSchemaId",
    "content",
    "contentHash",
    "sourceRef"
  ],
  "additionalProperties": false
}
