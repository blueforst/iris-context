{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iris:memory:expansion-response:v1",
  "title": "ExpansionResponseV1",
  "description": "Response for provenance expansion; not implemented in this slice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "memoryRef", "content", "status"],
  "properties": {
    "schemaVersion": {
      "const": "expansion-response-v1"
    },
    "memoryRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "content": {
      "type": "string",
      "maxLength": 200000
    },
    "status": {
      "enum": ["available", "not_ready", "memory_unavailable"]
    }
  }
}
