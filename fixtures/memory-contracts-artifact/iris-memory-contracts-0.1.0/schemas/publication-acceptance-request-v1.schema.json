{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iris:memory:publication-acceptance-request:v1",
  "title": "PublicationAcceptanceRequestV1",
  "description": "Idempotent acceptance request wrapping one HistorianPublication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "idempotencyKey", "publication"],
  "properties": {
    "schemaVersion": {
      "const": "publication-acceptance-request-v1"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "publication": {
      "type": "object",
      "minProperties": 1
    }
  }
}
