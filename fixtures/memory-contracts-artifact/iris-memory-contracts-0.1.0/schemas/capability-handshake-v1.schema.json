{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iris:memory:capability-handshake:v1",
  "title": "MemoryCapabilityHandshakeV1",
  "description": "Bootstrap capability and contract-version handshake.",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "contractVersion", "status", "capabilities"],
  "properties": {
    "service": {
      "const": "iris-memory"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["bootstrap", "not_ready", "ready", "degraded"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["health.read", "publication.accept", "recall.query", "recall.expand"]
      }
    }
  }
}
