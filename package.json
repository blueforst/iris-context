{
  "name": "@iris/context",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Iris Context + Historian domain plugin repository (Cordis/DSH plugin domain).",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check:codegen-freshness": "tsx scripts/check-codegen-freshness.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run check:codegen-freshness"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
